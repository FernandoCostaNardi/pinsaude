# ============================================================
# Pin Saúde — Variáveis de ambiente para desenvolvimento local
# Copie este arquivo para .env e ajuste se necessário
# ============================================================

# --- PostgreSQL ---
POSTGRES_DB=pinsaude
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5433

# --- RabbitMQ ---
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672

# --- Keycloak ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_PORT=8080

# --- Vault (dev mode) ---
VAULT_TOKEN=root
VAULT_PORT=8200

# --- Jaeger ---
JAEGER_UI_PORT=16686
JAEGER_OTLP_PORT=4317

# --- Mailhog ---
MAILHOG_SMTP_PORT=1025
MAILHOG_UI_PORT=8025
