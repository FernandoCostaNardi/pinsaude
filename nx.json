{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "main",
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "production": [
      "default",
      "!{projectRoot}/**/?(*.)+(spec|test).[jt]s?(x)",
      "!{projectRoot}/src/test/**/*"
    ],
    "sharedGlobals": ["{workspaceRoot}/pom.xml"]
  },
  "targetDefaults": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"],
      "cache": true
    },
    "test": {
      "inputs": ["default", "^production"],
      "cache": true
    },
    "lint": {
      "inputs": ["default", "{workspaceRoot}/.eslintrc*"],
      "cache": true
    }
  },
  "plugins": [],
  "projects": {
    "fiscal": {
      "root": "services/fiscal",
      "sourceRoot": "services/fiscal/src",
      "projectType": "application",
      "targets": {
        "build": {
          "executor": "nx:run-commands",
          "options": {
            "command": "mvn clean package -pl services/fiscal -am -DskipTests",
            "cwd": "{workspaceRoot}"
          }
        },
        "test": {
          "executor": "nx:run-commands",
          "options": {
            "command": "mvn test -pl services/fiscal",
            "cwd": "{workspaceRoot}"
          }
        }
      },
      "tags": ["scope:services", "type:backend"]
    },
    "faturamento": {
      "root": "services/faturamento",
