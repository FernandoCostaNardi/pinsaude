  "name": "gestao",
  "root": "services/gestao",
  "sourceRoot": "services/gestao/src",
  "projectType": "application",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tools\\scripts\\run.cmd tools/scripts/mvn-build.js services/gestao",
