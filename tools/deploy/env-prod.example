# Copiar para /home/pinsaude/infra/.env e preencher com senhas reais
# NUNCA versionar este arquivo com senhas reais

# Keycloak
KC_ADMIN_USER=admin
KC_ADMIN_PASS=TROCAR_POR_SENHA_FORTE
KC_DB_PASS=TROCAR_POR_SENHA_FORTE

# Onboarding service
DB_PASSWORD_ONBOARDING=TROCAR_POR_SENHA_FORTE

# MinIO — armazenamento de documentos
# ATENÇÃO: MINIO_ENDPOINT deve ser o IP/domínio público do servidor, não localhost.
# As URLs pré-assinadas geradas pelo Java usam esse endereço → browser precisa acessar.
MINIO_ENDPOINT=http://212.85.12.228:9000
MINIO_ACCESS_KEY=TROCAR_POR_USUARIO_FORTE
MINIO_SECRET_KEY=TROCAR_POR_SENHA_FORTE_MIN_8_CHARS
MINIO_BUCKET=pinsaude-documentos

# Gestão service
DB_PASSWORD_GESTAO=TROCAR_POR_SENHA_FORTE

# Faturamento service
DB_PASSWORD_FATURAMENTO=TROCAR_POR_SENHA_FORTE

# Fiscal service
DB_PASSWORD_FISCAL=TROCAR_POR_SENHA_FORTE

# Criptografia de dados sensíveis (CPF, chave PIX, dados bancários) — pgcrypto
# Mesma chave usada por onboarding e faturamento — não alterar após primeiro deploy
CRYPTO_KEY=TROCAR_POR_CHAVE_FORTE_32_CHARS

# RabbitMQ — filas de emissão NFS-e (fiscal service)
RABBITMQ_USER=pinsaude
RABBITMQ_PASSWORD=TROCAR_POR_SENHA_FORTE

# Integração NFS-e (agregador fiscal) — habilitar quando tiver contrato
NFSE_ENABLED=false
NFSE_API_TOKEN=
NFSE_BASE_URL=https://api.plugnotas.com.br
