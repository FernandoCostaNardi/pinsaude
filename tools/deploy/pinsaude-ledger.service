[Unit]
Description=Pin Saude - Ledger (livro-razao financeiro)
After=network.target postgresql.service

[Service]
Type=simple
User=pinsaude
Group=pinsaude
WorkingDirectory=/home/pinsaude/apps/ledger

EnvironmentFile=/home/pinsaude/infra/.env

ExecStart=/usr/bin/java \
  -Xms128m -Xmx256m \
  -Dspring.profiles.active=prod \
  -Dspring.config.additional-location=file:/home/pinsaude/apps/ledger/application-prod.yml \
  -jar /home/pinsaude/apps/ledger/app.jar

Restart=on-failure
RestartSec=15
StandardOutput=append:/home/pinsaude/logs/ledger.log
StandardError=append:/home/pinsaude/logs/ledger.log

[Install]
WantedBy=multi-user.target
