[Unit]
Description=Pin Saude - Repasse aos Medicos (scaffold - EPIC-09 nao implementado)
After=network.target postgresql.service

[Service]
Type=simple
User=pinsaude
Group=pinsaude
WorkingDirectory=/home/pinsaude/apps/repasse

EnvironmentFile=/home/pinsaude/infra/.env

ExecStart=/usr/bin/java \
  -Xms128m -Xmx256m \
  -Dspring.profiles.active=prod \
  -Dspring.config.additional-location=file:/home/pinsaude/apps/repasse/application-prod.yml \
  -jar /home/pinsaude/apps/repasse/app.jar

Restart=on-failure
RestartSec=15
StandardOutput=append:/home/pinsaude/logs/repasse.log
StandardError=append:/home/pinsaude/logs/repasse.log

[Install]
WantedBy=multi-user.target
